# =====================
# LongCat-frontend .gitignore
# =====================

# ---- 构建产物 / 二进制 ----
/bin/
*.exe
desktop/src-tauri/target/

# ---- 内部工作区（Agent 记忆、日志等，勿提交）----
.workbuddy/

# ---- 文档（仅保留 README.md 与前端技能定义 SKILL.md 作为源码，其余内部文档不提交）----
*.md
!README.md
!frontend-skills/**/*.md

# ---- 敏感信息 ----
# 环境变量 / 密钥 / 证书
.env
.env.*
*.key
*.pem
*.pfx
*.keystore
*.token
*secret*
credentials*

# LLM 供应商配置（含 API Key，位于用户主目录）
providers.json
.frontend-agent/
.longcat-frontend/

# ---- 日志 ----
*.log
