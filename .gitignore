# =====================
# LongCat-frontend .gitignore
# =====================

# ---- 构建产物 / 二进制 ----
/bin/
*.exe
*.exe~
*.exe.bak
*.exe.old
desktop/src-tauri/target/

# ---- 内部工作区（Agent 记忆、日志等，勿提交）----
.workbuddy/

# ---- 文档（仅保留 README.md 和 AGENTS.md 进版本库，其余 .md 不提交）----
*.md
!README.md
!AGENTS.md
!CONTRIBUTING.md
!ISSUES.md
!PLUGINS.md
!blog/
!blog/**

# ---- 本地 Go 构建缓存 ----
.gocache/
.gomodcache/
blog/public/
.hugo_build.lock

# ---- 敏感信息 ----
# 环境变量 / 密钥 / 证书
.env
.env.*
*.key
*.pem
*.pfx
*.keystore
*.token
*secret*
credentials*

# LLM 供应商配置（含 API Key，位于用户主目录）
providers.json
.frontend-agent/
.longcat-frontend/

# ---- 日志 ----
*.log
