{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "LongCat-frontend",
  "version": "0.2.0",
  "identifier": "com.longcatfrontend.desktop",
  "build": {
    "frontendDist": "http://127.0.0.1:5510",
    "devUrl": "http://127.0.0.1:5510",
    "beforeDevCommand": "..\\bin\\LongCat-frontend.exe serve -addr 127.0.0.1:5510"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "LongCat-frontend",
        "width": 1200,
        "height": 800,
        "minWidth": 900,
        "minHeight": 600,
        "center": true,
        "theme": "Dark"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["msi", "nsis"],
    "resources": {
      "../bin/LongCat-frontend.exe": "LongCat-frontend.exe"
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ]
  }
}
